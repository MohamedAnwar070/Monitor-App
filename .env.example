# ==============================================================
# Website URL Monitor - Environment Configuration Template
# Copy this file to .env and configure for your environment.
# ==============================================================

# --- Core Monitoring Settings ---
MONITOR_INPUT_FILE=Monitor Endpoints.xlsx
MONITOR_REPORT_FILE=reports/Website_Monitor_Report.xlsx
MONITOR_MAX_WORKERS=10
MONITOR_TIMEOUT=20
MONITOR_MAX_RETRIES=4
MONITOR_RETRY_DELAY=2.0
MONITOR_RUN_SESSION=               # Leave empty for auto (Morning / Afternoon)

# --- Screenshot Automation ---
MONITOR_WITH_SCREENSHOT=1          # 1 = Enable screenshots, 0 = Disable
MONITOR_AUTH_BROWSER_UI_SCREENSHOT=1
MONITOR_STRICT_SCREENSHOT_COVERAGE=0
SCREENSHOT_UPLOAD_PROVIDER=tmpfiles # Uploads to temporary host for public report links
SCREENSHOT_LINK_EXPIRE_SECONDS=172800

# --- Microsoft Teams & Power Automate Webhook (Optional) ---
TEAMS_WEBHOOK_URL=https://your-teams-or-power-automate-webhook-url

# --- Microsoft SharePoint / OneDrive Graph Integration (Optional) ---
SHAREPOINT_TENANT_ID=your-azure-tenant-id
SHAREPOINT_CLIENT_ID=your-azure-app-client-id
SHAREPOINT_CLIENT_SECRET=your-azure-app-client-secret
SHAREPOINT_WORKBOOK_URL=https://yourorg.sharepoint.com/:x:/g/your-workbook-id
SHAREPOINT_UPLOAD_SCREENSHOTS=1
SHAREPOINT_LINK_SCOPE=organization

# --- Remote GitHub Workflow Trigger (Optional) ---
MONITOR_GITHUB_PAT=ghp_yourPersonalAccessTokenHere
MONITOR_GITHUB_REPO=YOUR_GITHUB_USERNAME/Monitor-App
